# ARK-OS Minimal x86_64 Kernel Configuration (QEMU Target)
#
# Optimized for rapid CI compilation and early userspace testing in QEMU.
# Supports 64-bit ELF execution, initramfs, devtmpfs, virtio drivers, and serial console.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Binary Format Support
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Initial Ramdisk Support
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

# TTY and Serial Console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Virtual Filesystems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Bus and Virtio Hardware Drivers
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# Networking Basics
CONFIG_NET=y
CONFIG_INET=y

# Disable heavy debug info to keep compilation fast
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
